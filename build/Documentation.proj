<Project DefaultTargets="Build">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <DocumentationInputs>$(MSBuildThisFileDirectory)../artifacts/documentation/api</DocumentationInputs>
  </PropertyGroup>

  <ItemGroup>
    <!-- The v11 and classic ReactiveUI packages share the primary API's names.
         Document the primary runtime assemblies once, including generated members.
         Compiler analyzers target netstandard2.0 and are not runtime API inputs.
         AvalonDock compatibility is deferred until its framework APIs ship upstream. -->
    <DocumentationProject Include="$(MSBuildThisFileDirectory)../src/*/*.csproj"
                          Exclude="$(MSBuildThisFileDirectory)../src/*.v11/*.csproj;$(MSBuildThisFileDirectory)../src/*.Reactive/*.csproj;$(MSBuildThisFileDirectory)../src/*.Generators/*.csproj;$(MSBuildThisFileDirectory)../src/Dock.Avalonia.AvalonDock/*.csproj" />
  </ItemGroup>

  <Target Name="Restore">
    <MSBuild Projects="@(DocumentationProject)" Targets="Restore"
             Properties="Configuration=$(Configuration)"
             BuildInParallel="true" />
  </Target>

  <Target Name="Build" DependsOnTargets="Restore">
    <MSBuild Projects="@(DocumentationProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0;GenerateDocumentationFile=true"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="DocumentationAssembly" />
    </MSBuild>
    <ItemGroup>
      <DocumentationFile Include="@(DocumentationAssembly)" />
      <DocumentationFile Include="@(DocumentationAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
      <DocumentationFile Include="@(DocumentationAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <DocumentationFile Include="@(DocumentationAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <DocumentationMetadata Include="$(MSBuildThisFileDirectory)../docfx/api/*.yml;$(MSBuildThisFileDirectory)../docfx/api/*.manifest" />
    </ItemGroup>
    <!-- Replace only this target's staging directory so removed projects cannot
         leave stale API pages in a later documentation build. -->
    <RemoveDir Directories="$(DocumentationInputs)" />
    <Copy SourceFiles="@(DocumentationFile)" DestinationFolder="$(DocumentationInputs)" />
    <Delete Files="@(DocumentationMetadata)" />
    <RemoveDir Directories="$(MSBuildThisFileDirectory)../_site" />
  </Target>
</Project>
