<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:dmc="using:Dock.Model.Controls"
        x:Class="BrowserTabTheme.MainWindow"
        x:DataType="dmc:IDocumentDock"
        Title="BrowserTabTheme Sample"
        Width="1300"
        Height="820"
        Background="{DynamicResource DockSurfaceHeaderBrush}"
        ExtendClientAreaToDecorationsHint="{Binding LayoutMode, Converter={x:Static converters:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Tabbed}"
        ExtendClientAreaTitleBarHeightHint="-1"
        >
  <DockControl Name="DockControl" Margin="6" />
  
</Window>
