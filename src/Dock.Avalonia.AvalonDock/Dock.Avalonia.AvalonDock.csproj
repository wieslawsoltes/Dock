<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PackageId>Dock.Avalonia.AvalonDock</PackageId>
    <Description>AvalonDock API adapters backed by Dock's Avalonia models and controls.</Description>
    <PackageReadmeFile>AVALONDOCK.md</PackageReadmeFile>
  </PropertyGroup>
  <Import Project="../../build/SignAssembly.props" />
  <Import Project="../../build/SourceLink.props" />
  <Import Project="../../build/Avalonia.props" />
  <ItemGroup>
    <EmbeddedResource Update="Properties/Resources.resx" ManifestResourceName="AvalonDock.Properties.Resources" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <ProjectReference Include="../Dock.Model.Avalonia/Dock.Model.Avalonia.csproj" />
    <ProjectReference Include="../Dock.Avalonia.Themes.Fluent/Dock.Avalonia.Themes.Fluent.csproj" />
    <None Include="AVALONDOCK.md" Pack="true" PackagePath="/" />
    <None Include="COMPATIBILITY.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
