<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:fluent="using:Dock.Avalonia.Themes.Fluent"
        xmlns:deferred="using:Dock.Controls.DeferredContentControl"
        xmlns:models="using:Dock.Model.Avalonia.Controls"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        x:Class="AvalonDock.Themes.AvalonDockTheme"
        x:DataType="ad:DockingManager">
  <Styles.Resources>
    <infrastructure:LayoutContentTemplate x:Key="AvalonDockContentTemplate">
      <infrastructure:LayoutContentTemplate.DocumentTemplate>
        <DataTemplate x:DataType="models:Document">
          <ContentControl Classes="avalondock-content" Content="{Binding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DataTemplate>
      </infrastructure:LayoutContentTemplate.DocumentTemplate>
      <infrastructure:LayoutContentTemplate.ToolTemplate>
        <DataTemplate x:DataType="models:Tool">
          <ContentControl Classes="avalondock-content" Content="{Binding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DataTemplate>
      </infrastructure:LayoutContentTemplate.ToolTemplate>
    </infrastructure:LayoutContentTemplate>
    <ControlTheme x:Key="{x:Type ad:DockingManager}" TargetType="ad:DockingManager"
                  x:DataType="ad:DockingManager">
      <Setter Property="Template">
        <ControlTemplate>
          <dock:DockControl x:Name="PART_DockControl" Classes="avalondock"
                            Layout="{TemplateBinding DockLayout}"
                            Factory="{TemplateBinding DockFactory}"
                            HostWindowFactory="{TemplateBinding DockHostWindowFactory}"
                            infrastructure:LayoutSplitterSizing.Width="{TemplateBinding GridSplitterWidth}"
                            infrastructure:LayoutSplitterSizing.Height="{TemplateBinding GridSplitterHeight}"
                            InitializeFactory="True" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
  <fluent:DockFluentTheme />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutHeaders.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutDocumentMenus.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutSizing.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutCommands.axaml" />
  <Style Selector="dock|DockControl.avalondock dock|DocumentControl /template/ deferred|DeferredContentControl#PART_ContentPresenter">
    <Setter Property="ContentTemplate" Value="{StaticResource AvalonDockContentTemplate}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|ToolControl /template/ deferred|DeferredContentControl#PART_ContentPresenter">
    <Setter Property="ContentTemplate" Value="{StaticResource AvalonDockContentTemplate}" />
  </Style>
  <Style Selector="dock|HostWindow.avalondock dock|DocumentControl /template/ deferred|DeferredContentControl#PART_ContentPresenter">
    <Setter Property="ContentTemplate" Value="{StaticResource AvalonDockContentTemplate}" />
  </Style>
  <Style Selector="dock|HostWindow.avalondock dock|ToolControl /template/ deferred|DeferredContentControl#PART_ContentPresenter">
    <Setter Property="ContentTemplate" Value="{StaticResource AvalonDockContentTemplate}" />
  </Style>
</Styles>
