<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:fluent="using:Dock.Avalonia.Themes.Fluent"
        xmlns:models="using:Dock.Model.Avalonia.Controls"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        x:Class="AvalonDock.Themes.AvalonDockTheme"
        x:DataType="ad:DockingManager">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/GenericThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <fluent:DockFluentTheme />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutContent.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutPaneControls.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutHeaders.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutAnchors.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutAutoHide.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutTabPanels.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutDocumentMenus.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutDocumentWindows.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutFloatingWindowControls.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutSizing.axaml" />
  <StyleInclude Source="avares://Dock.Avalonia.AvalonDock/Themes/LayoutCommands.axaml" />
</Styles>
