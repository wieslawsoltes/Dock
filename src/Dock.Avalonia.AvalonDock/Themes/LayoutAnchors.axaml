<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls">
  <Style Selector="ad|DockingManager">
    <Setter Property="AnchorSideTemplate" Value="{StaticResource AvalonDockAnchorSide}" />
    <Setter Property="AnchorGroupTemplate" Value="{StaticResource AvalonDockAnchorGroup}" />
    <Setter Property="AnchorTemplate" Value="{StaticResource AvalonDockAnchor}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|ToolPinnedControl, :is(dock|HostWindow).avalondock dock|ToolPinnedControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockPinnedStrip}" />
  </Style>
</Styles>
