<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:ad="using:AvalonDock"
        xmlns:core="using:Dock.Model.Core"
        xmlns:dmc="using:Dock.Model.Controls"
        xmlns:deferred="using:Dock.Controls.DeferredContentControl"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:items="using:AvalonDock.Controls"
        xmlns:layout="using:AvalonDock.Layout"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        x:DataType="core:IDockable">

  <Style Selector="ad|DockingManager">
    <Setter Property="DocumentContextMenu" Value="{StaticResource AvalonDockDocumentCommands}" />
    <Setter Property="AnchorableContextMenu" Value="{StaticResource AvalonDockToolCommands}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock, :is(Window).avalondock dock|DockControl">
    <Setter Property="infrastructure:LayoutCommandRouting.IsEnabled" Value="True" />
    <Setter Property="infrastructure:LayoutContextMenuRouting.IsEnabled" Value="True" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|DockControl">
    <Setter Property="HostWindowFactory" Value="{Binding $self.(infrastructure:LayoutHostWindowFactory.Factory)}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|DocumentControl, :is(Window).avalondock dock|DocumentControl">
    <Setter Property="CloseTemplate" Value="{StaticResource AvalonDockDocumentCloseTemplate}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|DocumentTabStripItem, :is(Window).avalondock dock|DocumentTabStripItem">
    <Setter Property="DocumentContextMenu" Value="{x:Null}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|ToolTabStripItem, :is(Window).avalondock dock|ToolTabStripItem">
    <Setter Property="TabContextMenu" Value="{x:Null}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|ToolPinItemControl, :is(Window).avalondock dock|ToolPinItemControl">
    <Setter Property="PinContextMenu" Value="{x:Null}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|ToolChromeControl, :is(Window).avalondock dock|ToolChromeControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockToolChrome}" />
    <Setter Property="ToolFlyout" Value="{x:Null}" />
    <Style Selector="^ /template/ ContentPresenter#PART_Title">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="{DynamicResource DockToolChromeTitleMargin}" />
      <Setter Property="FontSize" Value="{DynamicResource DockFontSizeNormal}" />
    </Style>
    <Style Selector="^:active /template/ ContentPresenter#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource DockTabActiveForegroundBrush}" />
    </Style>
  </Style>
</Styles>
