<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dmc="using:Dock.Model.Controls"
        xmlns:converters="using:Dock.Avalonia.Converters">
  <!-- Compose the native pane controls with persistent adapter content bindings.
       Keeping these bindings in the templates also preserves logical ownership
       while ancestor styles detach and reattach. -->

  <Style Selector=":is(ad|DockingManager) dock|DocumentControl, dock|DockControl.avalondock dock|DocumentControl, :is(Window).avalondock dock|DocumentControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockDocumentContent}" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|ToolControl, dock|DockControl.avalondock dock|ToolControl, :is(Window).avalondock dock|ToolControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockToolContent}" />
  </Style>
</Styles>
