<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AvalonDock.Controls"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:layout="using:AvalonDock.Layout"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:DataType="controls:LayoutAnchorableFloatingWindowControl">

  <Style Selector=":is(controls|LayoutFloatingWindowControl):custom-content">
    <Setter Property="ContentTemplate" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(controls|LayoutFloatingWindowControl):toolwindow:toolchromecontrolswindow">
    <Setter Property="WindowDecorations" Value="{OnPlatform Windows={x:Static WindowDecorations.Full}, Default={x:Static WindowDecorations.BorderOnly}}" />
    <Setter Property="WindowDecorationsTheme" Value="{OnPlatform Windows={StaticResource AvalonDockContentWindowDecorations}, Default={x:Null}}" />
  </Style>
  <Style Selector="controls|LayoutAnchorableFloatingWindowControl">
    <Setter Property="infrastructure:LayoutItemBinding.Model"
            Value="{Binding $self.((layout:LayoutAnchorableFloatingWindow)Model).((layout:ILayoutContentSelector)SinglePane).SelectedContent}" />
    <Setter Property="SingleContentLayoutItem"
            Value="{Binding $self.(infrastructure:LayoutItemBinding.Item)}" />
  </Style>
</Styles>
