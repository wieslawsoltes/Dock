<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:docking="using:Dock.Settings"
        xmlns:core="using:Dock.Model.Core"
        xmlns:layout="using:AvalonDock.Layout"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        x:DataType="core:IDockable">

  <Style Selector=":is(ad|DockingManager) dock|DocumentControl, dock|DockControl.avalondock dock|DocumentControl">
    <Setter Property="HeaderTemplate" Value="{StaticResource AvalonDockDocumentTabHeader}" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|ToolControl, dock|DockControl.avalondock dock|ToolControl">
    <Setter Property="HeaderTemplate" Value="{StaticResource AvalonDockAnchorableTabHeader}" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|DocumentControl">
    <Setter Property="HeaderTemplate" Value="{StaticResource AvalonDockDocumentTabHeader}" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|ToolControl">
    <Setter Property="HeaderTemplate" Value="{StaticResource AvalonDockAnchorableTabHeader}" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|ToolPinItemControl, dock|DockControl.avalondock dock|ToolPinItemControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockAutoHideHeader}" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|ToolPinItemControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockAutoHideHeader}" />
  </Style>
</Styles>
