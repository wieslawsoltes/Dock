<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls">
  <Style Selector="dock|DockControl.avalondock dock|DocumentDockControl, :is(dock|HostWindow).avalondock dock|DocumentDockControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockDocumentPaneTemplate}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock dock|ToolDockControl, :is(dock|HostWindow).avalondock dock|ToolDockControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockToolPaneTemplate}" />
  </Style>
</Styles>
