<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:models="using:Dock.Model.Core"
        xmlns:docking="using:Dock.Settings"
        xmlns:proportional="using:Dock.Controls.ProportionalStackPanel"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        xmlns:controls="using:AvalonDock.Controls"
        x:DataType="models:IDockable">

  <Style Selector=":is(ad|DockingManager) dock|ProportionalDockControl, dock|DockControl.avalondock dock|ProportionalDockControl, :is(Window).avalondock dock|ProportionalDockControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockProportionalLayout}" />
  </Style>
  <Style Selector=":is(ad|DockingManager) :is(proportional|ProportionalStackPanelSplitter), dock|DockControl.avalondock :is(proportional|ProportionalStackPanelSplitter), :is(Window).avalondock :is(proportional|ProportionalStackPanelSplitter)">
    <Setter Property="(proportional:ProportionalStackPanelSplitter.MinimumProportionSize)" Value="0" />
  </Style>
  <Style Selector=":is(Control).avalondock-grid-child" x:DataType="models:IDockable">
    <Setter Property="MaxWidth" Value="{Binding MaxWidth}" />
    <Setter Property="MaxHeight" Value="{Binding MaxHeight}" />
  </Style>
  <!-- WPF grids allow fractional layout by default. Grid rounding can also
       distribute spare pixels into fixed definitions, changing resize limits. -->
  <Style Selector=":is(controls|LayoutPanelControl), :is(controls|LayoutDocumentPaneGroupControl), :is(controls|LayoutAnchorablePaneGroupControl)">
    <Setter Property="UseLayoutRounding" Value="False" />
  </Style>
</Styles>
