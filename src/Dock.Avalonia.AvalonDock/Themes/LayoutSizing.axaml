<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:models="using:Dock.Model.Controls"
        xmlns:docking="using:Dock.Settings"
        xmlns:proportional="using:Dock.Controls.ProportionalStackPanel"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:infrastructure="using:AvalonDock.Infrastructure"
        x:DataType="models:IProportionalDock">

  <Style Selector="dock|DockControl.avalondock dock|ProportionalDockControl, :is(dock|HostWindow).avalondock dock|ProportionalDockControl">
    <Setter Property="Template" Value="{StaticResource AvalonDockProportionalLayout}" />
  </Style>
  <Style Selector="dock|DockControl.avalondock proportional|ProportionalStackPanelSplitter, :is(dock|HostWindow).avalondock proportional|ProportionalStackPanelSplitter">
    <Setter Property="Thickness">
      <MultiBinding Converter="{StaticResource AvalonDockSplitterSize}">
        <Binding Path="(infrastructure:LayoutSplitterSizing.Width)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="(infrastructure:LayoutSplitterSizing.Height)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Orientation" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type proportional:ProportionalStackPanel}, Tree=Visual}" />
      </MultiBinding>
    </Setter>
  </Style>
</Styles>
