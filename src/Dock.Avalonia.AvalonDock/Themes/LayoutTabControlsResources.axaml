<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:AvalonDock.Controls"
                    xmlns:layout="using:AvalonDock.Layout"
                    xmlns:infrastructure="using:AvalonDock.Infrastructure">
  <DataTemplate x:Key="AvalonDockDefaultTabHeader" x:DataType="layout:LayoutContent">
    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
               Padding="{DynamicResource DockHeaderContentPadding}" />
  </DataTemplate>
  <infrastructure:LayoutHeaderTemplate x:Key="AvalonDockDocumentTabContent" Kind="Document"
                                       DefaultTemplate="{StaticResource AvalonDockDefaultTabHeader}" />
  <infrastructure:LayoutHeaderTemplate x:Key="AvalonDockAnchorableTabContent" Kind="Anchorable"
                                       DefaultTemplate="{StaticResource AvalonDockDefaultTabHeader}" />
  <ControlTheme x:Key="{x:Type controls:LayoutDocumentTabItem}" TargetType="controls:LayoutDocumentTabItem"
                x:DataType="controls:LayoutDocumentTabItem">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="Transparent" Content="{TemplateBinding LayoutItem}"
                          ContentTemplate="{StaticResource AvalonDockDocumentTabContent}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type controls:LayoutAnchorableTabItem}" TargetType="controls:LayoutAnchorableTabItem"
                x:DataType="controls:LayoutAnchorableTabItem">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="Transparent" Content="{TemplateBinding LayoutItem}"
                          ContentTemplate="{StaticResource AvalonDockAnchorableTabContent}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
