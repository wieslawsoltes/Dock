<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:AvalonDock"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:core="using:Dock.Model.Core"
        x:DataType="core:IDockable">
  <Style Selector=":is(ad|DockingManager) dock|DocumentTabStrip[Orientation=Horizontal], dock|DockControl.avalondock dock|DocumentTabStrip[Orientation=Horizontal]">
    <Setter Property="ItemsPanel" Value="{StaticResource AvalonDockDocumentTabPanel}" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|DocumentTabStrip[Orientation=Horizontal]">
    <Setter Property="ItemsPanel" Value="{StaticResource AvalonDockDocumentTabPanel}" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|ToolTabStrip, dock|DockControl.avalondock dock|ToolTabStrip">
    <Setter Property="ItemsPanel" Value="{StaticResource AvalonDockAnchorableTabPanel}" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|ToolTabStrip">
    <Setter Property="ItemsPanel" Value="{StaticResource AvalonDockAnchorableTabPanel}" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|ToolTabStripItem, dock|DockControl.avalondock dock|ToolTabStripItem">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|ToolTabStripItem">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|DocumentTabStrip[Orientation=Horizontal] /template/ ScrollViewer#PART_ScrollViewer, dock|DockControl.avalondock dock|DocumentTabStrip[Orientation=Horizontal] /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|DocumentTabStrip[Orientation=Horizontal] /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector=":is(ad|DockingManager) dock|ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer, dock|DockControl.avalondock dock|ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector=":is(Window).avalondock dock|ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
</Styles>
