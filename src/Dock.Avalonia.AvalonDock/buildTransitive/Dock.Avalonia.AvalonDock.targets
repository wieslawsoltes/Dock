<Project>
  <PropertyGroup>
    <!-- Official Avalonia does not yet support generated compiled-resource factories.
         Consumers can opt in for layout-only catalogs or use explicit typed registrations. -->
    <AvalonDockGenerateCatalog Condition="'$(AvalonDockGenerateCatalog)' == ''">false</AvalonDockGenerateCatalog>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="AvalonDockGenerateCatalog" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvalonDockResourcePath" />
  </ItemGroup>
  <Target Name="CollectAvalonDockCatalogResources" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
          DependsOnTargets="_InjectAvaloniaAdditionalFiles">
    <ItemGroup>
      <AdditionalFiles Condition="'%(AdditionalFiles.SourceItemGroup)' == 'AvaloniaXaml' Or '%(AdditionalFiles.SourceItemGroup)' == 'AvaloniaResource'">
        <AvalonDockResourcePath Condition="'%(AdditionalFiles.Link)' != ''">%(AdditionalFiles.Link)</AvalonDockResourcePath>
        <AvalonDockResourcePath Condition="'%(AdditionalFiles.Link)' == ''">%(AdditionalFiles.Identity)</AvalonDockResourcePath>
      </AdditionalFiles>
    </ItemGroup>
  </Target>
</Project>
