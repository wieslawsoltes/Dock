<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackageConsumer"
        xmlns:ad="http://schemas.xceed.com/wpf/xaml/avalondock"
        x:Class="PackageConsumer.AnchorControlWindow"
        x:DataType="DockingManager" Width="900" Height="650">
  <Window.Resources>
    <ControlTemplate x:Key="CustomAnchor" TargetType="LayoutAnchorControl" x:DataType="LayoutAnchorControl">
      <Border Padding="10" Background="Transparent">
        <TextBlock x:Name="CustomAnchorHeader" Text="{Binding ((LayoutAnchorable)Model).Title, RelativeSource={RelativeSource TemplatedParent}}" />
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="CustomSide" TargetType="ad:LayoutAnchorSideControl" x:DataType="ad:LayoutAnchorSideControl">
      <ItemsControl x:Name="CustomSideItems" ItemsSource="{Binding Children, RelativeSource={RelativeSource TemplatedParent}}" />
    </ControlTemplate>
    <ControlTemplate x:Key="CustomGroup" TargetType="LayoutAnchorGroupControl" x:DataType="LayoutAnchorGroupControl">
      <ItemsControl x:Name="CustomGroupItems" ItemsSource="{Binding Children, RelativeSource={RelativeSource TemplatedParent}}" />
    </ControlTemplate>
  </Window.Resources>
  <Window.Styles>
    <AvalonDockTheme />
    <Style Selector="LayoutAnchorSideControl" x:DataType="LayoutAnchorSideControl">
      <Setter Property="Tag" Value="{Binding $self.Model}" />
    </Style>
    <Style Selector="ad|LayoutAnchorGroupControl" x:DataType="ad:LayoutAnchorGroupControl">
      <Setter Property="Tag" Value="{Binding $self.Model}" />
    </Style>
    <Style Selector="LayoutAnchorControl" x:DataType="LayoutAnchorControl">
      <Setter Property="Tag" Value="{Binding $self.Model}" />
    </Style>
  </Window.Styles>
  <local:AnchorManagerProbe x:Name="Manager">
    <LayoutRoot>
      <LayoutPanel><LayoutDocumentPane><LayoutDocument ContentId="editor" Title="Editor" Content="Document" /></LayoutDocumentPane></LayoutPanel>
      <LayoutRoot.LeftSide>
        <LayoutAnchorSide><LayoutAnchorGroup>
          <LayoutAnchorable ContentId="left-a" Title="Left A"><TextBox Text="Left A content" /></LayoutAnchorable>
          <LayoutAnchorable ContentId="left-b" Title="Left B" Content="Left B content" />
        </LayoutAnchorGroup></LayoutAnchorSide>
      </LayoutRoot.LeftSide>
      <LayoutRoot.TopSide>
        <ad:LayoutAnchorSide><ad:LayoutAnchorGroup><ad:LayoutAnchorable ContentId="top" Title="Top" Content="Top content" /></ad:LayoutAnchorGroup></ad:LayoutAnchorSide>
      </LayoutRoot.TopSide>
      <LayoutRoot.RightSide>
        <LayoutAnchorSide><LayoutAnchorGroup><LayoutAnchorable ContentId="right" Title="Right" Content="Right content" /></LayoutAnchorGroup></LayoutAnchorSide>
      </LayoutRoot.RightSide>
      <LayoutRoot.BottomSide>
        <LayoutAnchorSide><LayoutAnchorGroup><LayoutAnchorable ContentId="bottom" Title="Bottom" Content="Bottom content" /></LayoutAnchorGroup></LayoutAnchorSide>
      </LayoutRoot.BottomSide>
    </LayoutRoot>
  </local:AnchorManagerProbe>
</Window>
