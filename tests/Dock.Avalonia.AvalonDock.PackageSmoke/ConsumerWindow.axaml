<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackageConsumer.ConsumerWindow" x:DataType="DockingManager"
        Width="640" Height="480">
  <Window.Styles>
    <AvalonDockTheme />
  </Window.Styles>
  <DockingManager x:Name="Manager">
    <LayoutRoot>
      <LayoutPanel>
        <LayoutDocumentPane>
          <LayoutDocument Title="NuGet document" ContentId="document">
            <TextBox Text="Package consumer" />
          </LayoutDocument>
        </LayoutDocumentPane>
      </LayoutPanel>
      <LayoutRoot.LeftSide>
        <LayoutAnchorSide>
          <LayoutAnchorGroup>
            <LayoutAnchorable ContentId="agenda" Title="Agenda">
              <TextBlock Text="Package auto-hide content" />
            </LayoutAnchorable>
          </LayoutAnchorGroup>
        </LayoutAnchorSide>
      </LayoutRoot.LeftSide>
    </LayoutRoot>
  </DockingManager>
</Window>
