<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackageConsumer"
        x:Class="PackageConsumer.ConsumerWindow" x:DataType="DockingManager"
        Width="640" Height="480">
  <Window.Resources>
    <LayoutDocumentItem x:Key="Container" Description="Unprefixed packaged container" />
    <DataTemplate x:Key="ExplicitTemplate" x:DataType="x:Object">
      <TextBlock Classes="explicit-package-template" Text="Explicit package template" />
    </DataTemplate>
    <DataTemplate x:Key="DocumentHeader" x:DataType="LayoutContent">
      <TextBlock Classes="package-document-header" Text="{Binding Title, StringFormat='Tab: {0}'}" />
    </DataTemplate>
    <DataTemplate x:Key="ToolHeader" x:DataType="LayoutAnchorable">
      <TextBlock Classes="package-tool-header" Text="{Binding Title, StringFormat='Tool: {0}'}" />
    </DataTemplate>
    <ControlTheme x:Key="SourceContainerStyle" TargetType="LayoutDocumentItem" x:DataType="LayoutDocumentItem">
      <Setter Property="Title" Value="{Binding Model, StringFormat='Styled: {0}'}" />
      <Setter Property="CanFloat" Value="True" />
    </ControlTheme>
    <ControlTheme x:Key="ExplicitContainerStyle" TargetType="LayoutItem" x:DataType="LayoutItem">
      <Setter Property="Title" Value="Explicit package container" />
      <Setter Property="CanFloat" Value="False" />
    </ControlTheme>
    <StyleSelector x:Key="DefaultStyleSelector" />
    <local:SourceStyleSelector x:Key="SourceStyleSelector" SourceStyle="{StaticResource SourceContainerStyle}" />
  </Window.Resources>
  <Window.Styles>
    <AvalonDockTheme />
  </Window.Styles>
  <DockingManager x:Name="Manager" LayoutItemContainerStyleSelector="{StaticResource SourceStyleSelector}"
                  DocumentHeaderTemplate="{StaticResource DocumentHeader}"
                  AnchorableHeaderTemplate="{StaticResource ToolHeader}">
    <DockingManager.DocumentContextMenu>
      <ContextMenu x:DataType="LayoutItem">
        <MenuItem Header="Close package document" Command="{Binding CloseCommand}" />
      </ContextMenu>
    </DockingManager.DocumentContextMenu>
    <DockingManager.AnchorableContextMenu>
      <ContextMenu x:DataType="LayoutAnchorableItem">
        <MenuItem Header="Restore package tool" Command="{Binding AutoHideCommand}" />
      </ContextMenu>
    </DockingManager.AnchorableContextMenu>
    <DockingManager.DataTemplates>
      <DataTemplate DataType="{x:Type x:String}" x:DataType="x:String">
        <TextBlock Classes="source-template" Text="{Binding .}" />
      </DataTemplate>
    </DockingManager.DataTemplates>
    <LayoutRoot>
      <LayoutPanel>
        <LayoutDocumentPane>
          <LayoutDocument Title="NuGet document" ContentId="document">
            <TextBox Text="Package consumer" />
          </LayoutDocument>
        </LayoutDocumentPane>
      </LayoutPanel>
      <LayoutRoot.LeftSide>
        <LayoutAnchorSide>
          <LayoutAnchorGroup>
            <LayoutAnchorable ContentId="agenda" Title="Agenda">
              <TextBlock Text="Package auto-hide content" />
            </LayoutAnchorable>
          </LayoutAnchorGroup>
        </LayoutAnchorSide>
      </LayoutRoot.LeftSide>
    </LayoutRoot>
  </DockingManager>
</Window>
