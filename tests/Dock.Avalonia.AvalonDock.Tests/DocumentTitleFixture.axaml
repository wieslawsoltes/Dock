<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Dock.Avalonia.AvalonDock.Tests"
        x:Class="Dock.Avalonia.AvalonDock.Tests.DocumentTitleFixture"
        x:DataType="local:SourceViewModel" Width="850" Height="550">
  <Window.Resources>
    <DataTemplate x:Key="DocumentTitle" x:DataType="LayoutDocument">
      <TextBlock Classes="document-title" Background="Transparent" Text="{Binding Title, StringFormat='Window: {0}'}" />
    </DataTemplate>
    <DataTemplate x:Key="AlternateTitle" x:DataType="LayoutContent">
      <TextBlock Classes="alternate-document-title" Text="{Binding ContentId, StringFormat='ID: {0}'}" />
    </DataTemplate>
    <DataTemplate x:Key="DocumentHeader" x:DataType="LayoutContent">
      <TextBlock Classes="document-tab" Text="{Binding Title, StringFormat='Tab: {0}'}" />
    </DataTemplate>
  </Window.Resources>
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type local:SourceContent}" x:DataType="local:SourceContent">
      <TextBlock Text="{Binding Text}" />
    </DataTemplate>
  </Window.DataTemplates>
  <DockingManager x:Name="Manager" DocumentsSource="{Binding Documents}" AnchorablesSource="{Binding Tools}"
                  LayoutUpdateStrategy="{Binding Strategy}"
                  DocumentHeaderTemplate="{StaticResource DocumentHeader}"
                  DocumentTitleTemplate="{StaticResource DocumentTitle}" />
</Window>
