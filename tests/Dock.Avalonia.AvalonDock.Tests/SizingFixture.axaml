<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="http://schemas.xceed.com/wpf/xaml/avalondock"
        x:Class="Dock.Avalonia.AvalonDock.Tests.SizingFixture"
        x:DataType="DockingManager" Width="1000" Height="720">
  <Window.Resources>
    <ControlTheme x:Key="Overlay" TargetType="OverlayWindow" x:DataType="OverlayWindow"
                  BasedOn="{StaticResource {x:Type OverlayWindow}}">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
      <Setter Property="Tag" Value="{x:Static DropTargetType.DocumentPaneDockAsAnchorableBottom}" />
    </ControlTheme>
    <ControlTheme x:Key="LegacyOverlay" TargetType="ad:OverlayWindow" x:DataType="ad:OverlayWindow"
                  BasedOn="{StaticResource {x:Type ad:OverlayWindow}}">
      <Setter Property="Tag" Value="{x:Static ad:OverlayWindowDropTargetType.AnchorablePaneDockInside}" />
    </ControlTheme>
    <DataTemplate x:Key="Resizer" x:DataType="x:Object">
      <LayoutGridResizerControl BackgroundWhileDragging="Blue" OpacityWhileDragging="0.7" />
    </DataTemplate>
    <DataTemplate x:Key="LegacyResizer" x:DataType="x:Object">
      <ad:LayoutGridResizerControl BackgroundWhileDragging="Blue" OpacityWhileDragging="0.7" />
    </DataTemplate>
    <AnchorableContextMenuAutoHideHeaderConverter x:Key="AutoHideHeaderConverter" />
    <ad:UriSourceToBitmapImageConverter x:Key="UriImageConverter" />
  </Window.Resources>
  <DockingManager x:Name="Manager" GridSplitterWidth="12" GridSplitterHeight="8" Margin="16">
    <LayoutRoot>
      <LayoutPanel>
        <LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="420">
          <LayoutAnchorablePane DockHeight="200" DockWidth="140">
            <LayoutAnchorable ContentId="top" Title="Top">
              <TextBlock Text="Top tool" />
            </LayoutAnchorable>
          </LayoutAnchorablePane>
          <LayoutAnchorablePane>
            <LayoutAnchorable ContentId="bottom" Title="Bottom">
              <TextBlock Text="Bottom tool" />
            </LayoutAnchorable>
          </LayoutAnchorablePane>
        </LayoutAnchorablePaneGroup>
        <LayoutDocumentPane>
          <LayoutDocument ContentId="document" Title="Document">
            <TextBlock Text="Sizing document" />
          </LayoutDocument>
        </LayoutDocumentPane>
      </LayoutPanel>
    </LayoutRoot>
  </DockingManager>
</Window>
